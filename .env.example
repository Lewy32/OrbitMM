# OrbitMM Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================================
# REQUIRED CONFIGURATION
# ============================================================

# Solana RPC endpoint
# Get a free RPC from: Helius, QuickNode, Alchemy, or use public endpoints
# Public (rate limited): https://api.mainnet-beta.solana.com
# Devnet: https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ============================================================
# OPTIONAL: Multiple RPCs for failover/load balancing
# ============================================================

# Comma-separated list of RPC endpoints for rotation
# SOLANA_RPC_URLS=https://rpc1.com,https://rpc2.com,https://rpc3.com

# ============================================================
# WALLET CONFIGURATION
# ============================================================

# Path to encrypted wallet file
# Default: ~/.orbitmm/wallets.json
# ORBITMM_WALLET_PATH=~/.orbitmm/wallets.json

# Path to OrbitMM config/state directory
# Default: ~/.orbitmm
# ORBITMM_CONFIG_PATH=~/.orbitmm

# ============================================================
# DETECTION ENGINE
# ============================================================

# Allium API key for enhanced detection features
# Get one at: https://allium.so
# Optional: On-chain detection works without this
# ALLIUM_API_KEY=your-allium-api-key

# ============================================================
# DEX CONFIGURATION
# ============================================================

# Jupiter API URL (optional, uses default if not set)
# JUPITER_API_URL=https://quote-api.jup.ag/v6

# Raydium API URL (optional, uses default if not set)
# RAYDIUM_API_URL=https://api.raydium.io/v2

# ============================================================
# TRADING DEFAULTS
# ============================================================

# Default slippage tolerance in basis points (100 = 1%)
# DEFAULT_SLIPPAGE_BPS=50

# Default priority fee in lamports
# DEFAULT_PRIORITY_FEE=1000

# ============================================================
# ALERTING & NOTIFICATIONS
# ============================================================

# Discord webhook URL for alerts
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram bot token (from @BotFather)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram chat ID for notifications
# TELEGRAM_CHAT_ID=-1001234567890

# Generic webhook URL for custom integrations
# CUSTOM_WEBHOOK_URL=https://your-server.com/webhook

# ============================================================
# LOGGING & DEBUGGING
# ============================================================

# Log level: debug, info, warn, error
# LOG_LEVEL=info

# Enable debug output for specific modules
# DEBUG=orbitmm:*

# ============================================================
# PERFORMANCE TUNING
# ============================================================

# Maximum concurrent swap operations
# MAX_CONCURRENT_SWAPS=50

# Connection timeout in milliseconds
# CONNECTION_TIMEOUT_MS=30000

# Transaction confirmation timeout in milliseconds
# CONFIRM_TIMEOUT_MS=60000

# ============================================================
# SECURITY
# ============================================================

# Require password confirmation for destructive operations
# REQUIRE_CONFIRMATION=true

# Encrypt all state files
# ENCRYPT_STATE=false
