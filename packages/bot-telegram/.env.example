# OrbitMM Telegram Bot Configuration
# Copy this to .env and fill in your values

# Required: Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Required: Owner Telegram User ID(s)
# Get your ID by messaging @userinfobot
# Multiple IDs can be comma-separated: 123456789,987654321
OWNER_ID=your_telegram_user_id

# Optional: Solana RPC URL
# Default: https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: Deny unauthorized users silently (no message)
# Default: false (sends access denied message)
SILENT_DENY=false

# Optional: Encryption key for wallet storage
# If not set, will prompt for password
# ORBITMM_ENCRYPTION_KEY=your_secure_key_here

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info
